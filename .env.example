# Docker settings for OpenAvatarStudio. Copy to .env next to docker-compose.yml.

# --- Access ---------------------------------------------------------------------
# Port on this machine for the studio (http://localhost:8080).
OAS_HTTP_PORT=8080
OAS_HTTPS_PORT=8443
# Ask for a login on every page and API call. Strongly recommended on a server.
OAS_USERNAME=admin
OAS_PASSWORD=
# Public hostname for automatic HTTPS (Let's Encrypt). Point its DNS at this
# machine and set OAS_HTTP_PORT=80 and OAS_HTTPS_PORT=443.
OAS_DOMAIN=

# --- Image ------------------------------------------------------------------------
# Engines baked into the image: any of coqui wav2lip sadtalker gfpgan. Leave
# empty for a small image with only the placeholder engines.
OAS_ENGINES=coqui wav2lip sadtalker gfpgan
# cpu, or cuda (docker-compose.gpu.yml sets cuda for you).
OAS_TORCH=cpu

# --- Studio -----------------------------------------------------------------------
OAS_MAX_CONCURRENT_JOBS=1
OAS_RETENTION_DAYS=0
ELEVENLABS_API_KEY=
