# SnS Palace settings. Copy to .env.local and fill in:
#   cp .env.local.example .env.local
# Both the web app (npm run dev / npm start) and the editing worker
# (npm run worker) read this file. Never commit .env.local.

# ---------------------------------------------------------------------------
# Household access
# ---------------------------------------------------------------------------
# Kids type this on the PIN pad to open the app (4 to 12 digits).
FAMILY_PIN=
# Grown-ups only: unlocks the /parent review room (6 to 12 digits, different
# from FAMILY_PIN). Entering it on a new device also signs that device in.
PARENT_PIN=
# Signs the session cookies. At least 32 random characters:
#   openssl rand -base64 48
# Changing it, or either PIN, signs every device out.
SESSION_SECRET=
# How long a device stays unlocked.
FAMILY_SESSION_DAYS=30
PARENT_SESSION_MINUTES=30

# ---------------------------------------------------------------------------
# Database: supabase (default) or local
# ---------------------------------------------------------------------------
DATABASE_DRIVER=supabase
# Supabase dashboard → Project Settings → API. Use the service-role key (or a
# new-style sb_secret_… key). It stays on the server; the browser never sees it.
# Create the table first: run supabase/schema.sql in the SQL Editor.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Video storage and streaming: cloudinary (default) or local
# ---------------------------------------------------------------------------
STORAGE_DRIVER=cloudinary
# Cloudinary console → Settings → API Keys. Videos are stored as private
# ("authenticated") assets and streamed only to signed-in household devices.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder that holds every SnS Palace asset in your Cloudinary media library.
CLOUDINARY_FOLDER=sns-palace

# Fully offline instead: set DATABASE_DRIVER=local and/or STORAGE_DRIVER=local.
# The SQLite database and media files then live in this folder.
LOCAL_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Largest video a kid can upload, in MB.
MAX_UPLOAD_MB=1024

# ---------------------------------------------------------------------------
# Editing worker (npm run worker)
# ---------------------------------------------------------------------------
# Speech-to-text for word timings and captions:
#   local  - faster-whisper on this machine; audio never leaves the house
#            (pip install -r worker/requirements.txt)
#   openai - OpenAI's Whisper API (sends the audio track to OpenAI)
#   none   - no transcription: no captions, silence trimming still works
TRANSCRIBER=local
# Python that has faster-whisper installed (e.g. worker/.venv/bin/python).
WHISPER_PYTHON=python3
# tiny.en, base.en, small.en, medium.en (bigger is more accurate, slower), or
# multilingual tiny, base, small, medium, large-v3.
WHISPER_MODEL=base.en
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Silence trimming: pauses at least this long are cut out...
SILENCE_MIN_SECONDS=1.5
# ...where "silence" is quieter than this level (closer to 0 = trims more).
SILENCE_NOISE_DB=-35
# Seconds of the pause kept on each side of a cut, so speech isn't clipped.
SILENCE_PADDING_SECONDS=0.25

# Burn big, colourful captions into the edited video.
CAPTIONS=true
# Even out loudness (EBU R128) so every video in the feed plays at the same volume.
NORMALIZE_AUDIO=true
# Also encode a VP9/Opus WebM copy of each edit, for browsers built without
# H.264 (some Linux Chromium builds). Costs about one more fast encode.
OUTPUT_WEBM=true
# Longest side of the edited video in pixels (1280 = 720p). Never upscales.
OUTPUT_MAX_SIZE=1280
# H.264 quality (lower = better and bigger; 18-28 is sensible) and speed preset.
VIDEO_CRF=23
VIDEO_PRESET=medium

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# How often the worker checks for new uploads, in milliseconds.
WORKER_POLL_MS=3000
# Tries per video before it is marked failed (transient errors only).
WORKER_MAX_ATTEMPTS=3
# A video whose worker sends no heartbeat for this long is handed to another worker.
WORKER_STALE_SECONDS=300
