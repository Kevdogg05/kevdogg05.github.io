{
  "name": "sns-palace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently --kill-others-on-fail --names web,worker --prefix-colors magenta,cyan \"next dev\" \"npm run worker\"",
    "build": "next build",
    "start": "next start",
    "start:all": "concurrently --kill-others-on-fail --names web,worker --prefix-colors magenta,cyan \"next start\" \"npm run worker\"",
    "worker": "tsx worker/index.ts",
    "sample": "bash worker/make-sample-video.sh",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@next/env": "^16.4.2",
    "@supabase/supabase-js": "^2.118.0",
    "cloudinary": "^2.11.0",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "^20.1.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "description": "A private, self-hosted video studio for kids: upload, auto-edit with captions, and a parent-approved feed.",
  "engines": {
    "node": ">=22.13"
  }
}
