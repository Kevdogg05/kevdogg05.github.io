# Settings for running SnS Palace with Docker Compose (compose.yaml). Copy
# this file to .env in the sns-palace folder and fill it in:
#   cp docker/home.env.example .env        (Windows: copy docker\home.env.example .env)
# Never share .env or commit it.

# Kids type this on the PIN pad (4 to 12 digits; 6 or more is safer).
FAMILY_PIN=
# Grown-ups only: opens the parent room (6 to 12 digits, different from FAMILY_PIN).
PARENT_PIN=

# A Tailscale auth key, used once so the "sns-palace" device can join your
# Tailscale network: admin console (login.tailscale.com) → Settings → Keys →
# Generate auth key. It starts with tskey-auth-.
TS_AUTHKEY=

# Optional. Signs the session cookies; when empty, SnS Palace generates one
# and keeps it with the videos. Changing it signs every device out.
SESSION_SECRET=
