# Copy to backend/.env and adjust. Every value shown is the default.

# --- Server -------------------------------------------------------------------
# OAS_STORAGE_DIR=storage
# OAS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# OAS_MAX_UPLOAD_MB=10
# OAS_MAX_SCRIPT_CHARS=5000
# OAS_MAX_CONCURRENT_JOBS=1
# OAS_FFMPEG_PATH=            # defaults to ffmpeg on PATH, then the imageio-ffmpeg binary

# --- Voice generation: placeholder | coqui | elevenlabs ------------------------
# OAS_TTS_PROVIDER=placeholder

# Coqui TTS (pip install coqui-tts)
# OAS_COQUI_MODEL=tts_models/en/vctk/vits
# OAS_COQUI_SPEAKERS=p225,p226,p227,p228,p229,p230
# OAS_COQUI_DEVICE=cpu        # or cuda

# ElevenLabs
# ELEVENLABS_API_KEY=
# OAS_ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Lip-sync: placeholder | wav2lip | sadtalker -------------------------------
# OAS_LIPSYNC_ENGINE=placeholder
# OAS_ENGINE_TIMEOUT_SECONDS=1800

# Wav2Lip (git clone https://github.com/Rudrabha/Wav2Lip)
# OAS_WAV2LIP_DIR=/path/to/Wav2Lip
# OAS_WAV2LIP_CHECKPOINT=/path/to/Wav2Lip/checkpoints/wav2lip_gan.pth
# OAS_WAV2LIP_PYTHON=/path/to/wav2lip-env/bin/python

# SadTalker (git clone https://github.com/OpenTalker/SadTalker)
# OAS_SADTALKER_DIR=/path/to/SadTalker
# OAS_SADTALKER_PYTHON=/path/to/sadtalker-env/bin/python
# OAS_SADTALKER_EXTRA_ARGS=--still --preprocess full
