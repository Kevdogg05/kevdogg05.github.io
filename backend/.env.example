# Copy to backend/.env and adjust. Every value shown is the default.

# --- Server -------------------------------------------------------------------
# OAS_STORAGE_DIR=storage
# OAS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# OAS_MAX_UPLOAD_MB=10
# OAS_MAX_SCRIPT_CHARS=5000
# OAS_MAX_CONCURRENT_JOBS=1                   # renders at once; the rest queue
# OAS_RETENTION_DAYS=0                        # delete finished videos older than this (0 = keep)
# OAS_FFMPEG_PATH=            # defaults to ffmpeg on PATH, then the imageio-ffmpeg binary

# --- Voice generation: placeholder | coqui | elevenlabs ------------------------
# OAS_TTS_PROVIDER=placeholder

# Coqui TTS: run scripts/setup_coqui.sh (needs the espeak-ng system package)
# OAS_COQUI_MODEL=tts_models/en/vctk/vits
# OAS_COQUI_SPEAKERS=p241=Deep voice,p273    # "speaker" or "speaker=Description"
# OAS_COQUI_LANGUAGE=en                       # multilingual models (XTTS) only
# OAS_COQUI_DEVICE=cpu                        # or cuda
# OAS_COQUI_PRELOAD=true                      # load the model at startup

# ElevenLabs
# ELEVENLABS_API_KEY=
# OAS_ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Animation: default engine (each video can pick another) ------------------
# OAS_LIPSYNC_ENGINE=placeholder              # wav2lip | sadtalker | placeholder
# OAS_ENGINE_TIMEOUT_SECONDS=1800

# Wav2Lip: run scripts/setup_wav2lip.sh (installs into backend/engines/Wav2Lip)
# OAS_WAV2LIP_DIR=engines/Wav2Lip
# OAS_WAV2LIP_CHECKPOINT=engines/Wav2Lip/checkpoints/wav2lip_gan.pth
# OAS_WAV2LIP_PYTHON=                         # defaults to this venv's python
# OAS_WAV2LIP_BATCH_SIZE=32

# SadTalker: run scripts/setup_sadtalker.sh (installs into backend/engines/SadTalker)
# OAS_SADTALKER_DIR=engines/SadTalker
# OAS_SADTALKER_PYTHON=                       # defaults to this venv's python
# OAS_SADTALKER_BATCH_SIZE=2                  # raise on a GPU
# OAS_SADTALKER_EXTRA_ARGS=                   # e.g. --expression_scale 1.2

# --- Face enhancement (GFPGAN v1.4): run scripts/setup_gfpgan.sh ---------------
# OAS_FACE_WEIGHTS_DIR=engines/gfpgan/weights
# OAS_ENHANCER_PYTHON=                        # defaults to this venv's python
